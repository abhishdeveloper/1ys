# Disable PHP execution in the uploads directory
<FilesMatch "\.(php|php[3-7]|phtml|pht)$">
    SetHandler default-handler
</FilesMatch>

# Only allow specific image formats
<FilesMatch "(?i)\.(jpe?g|png|gif|webp)$">
    # Allowed
</FilesMatch>

# Deny execution of everything else
<FilesMatch "(?i)\.(?!jpe?g|png|gif|webp)">
    Require all denied
</FilesMatch>

Options -Indexes
